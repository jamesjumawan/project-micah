{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/manifest.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                },
                {
                    "key": "Content-Type",
                    "value": "application/manifest+json"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/assets/models/:path*",
            "destination": "/assets/assets/models/:path*"
        },
        {
            "source": "/assets/Objects/:path*",
            "destination": "/assets/assets/Objects/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}